# 24. Quality assurance
# 24.4 Control charts for means
## Example 24.1. Control chart for percentage of uranium in UO2 powder
mu_target = 87.6 = 87.6
sig = 0.06 = 0.06
$M M[0] {87.54,87.56,87.50,87.47,87.64,87.56,87.71,87.61,87.60,87.60,87.47,87.60,87.69,87.78,87.69,87.72,87.77,87.79,87.78} > OK (19[0~18])
UCL = mu_target + 3*sig = 87.78
LCL = mu_target - 3*sig = 87.42
seqNo = ARR.INIT.LINE1D(18,1,19) = OK: seqNo (19[0~18])
arrUCL = ARR.INIT1D(19,UCL) = OK: arrUCL (19[0~18])
arrLCL = ARR.INIT1D(19,LCL) = OK: arrLCL (19[0~18])
arrMuTrg = ARR.INIT1D(19,mu_target) = OK: arrMuTrg (19[0~18])
! Figure 24.1. A control chart for batches of UO2 powder (Table 24.1)
$TS seqNo,seqNo,seqNo,seqNo;M,arrUCL,arrLCL,arrMuTrg;A control chart for batches of UO2 powder;Sequence number;Percent uranium;Table 24.1,UCL=87.78,LCL=87.42,μ_trg=87.60;0,2,2,2;10,0,0,0;MR > OK
# 24.5 Run test for control charts
UCL1 = mu_target + 1*sig = 87.66
LCL1 = mu_target - 1*sig = 87.54
UCL2 = mu_target + 2*sig = 87.72
LCL2 = mu_target - 2*sig = 87.48
arrUCL1 = ARR.INIT1D(19,UCL1) = OK: arrUCL1 (19[0~18])
arrLCL1 = ARR.INIT1D(19,LCL1) = OK: arrLCL1 (19[0~18])
arrUCL2 = ARR.INIT1D(19,UCL2) = OK: arrUCL2 (19[0~18])
arrLCL2 = ARR.INIT1D(19,LCL2) = OK: arrLCL2 (19[0~18])
! Figure 24.2. Figure 24.1 with σ and 2σ limits added
$TS seqNo,seqNo,seqNo,seqNo,seqNo,seqNo,seqNo,seqNo;M,arrUCL,arrUCL2,arrUCL1,arrMuTrg,arrLCL1,arrLCL2,arrLCL;Figure 24.1 with σ and 2σ limits added;Sequence number;Percent uranium;Table 24.1,UCL=87.78,Upper 2σ,Upper 1σ,μ_trg=87.60,Lower 1σ,Lower 2σ,LCL=87.42;0,2,2,2,2,2,2,2;10,0,0,0,0,0,0,0;LR > OK
# 24.6 Control charts for variability
## Example 24.2. Upper control and warning limits for σ
sig_trg = 0.06 = 0.06
n = 10 = 10
v = n-1 = 9
p1 = 0.995 = 0.995
p2 = 0.95 = 0.95
X2_1 = MATH.ICDF.CHI(v,p1) = 23.5893507812574
X2_2 = MATH.ICDF.CHI(v,p2) = 16.9189776046204
* (n-1)S^2/sig^2 = X2 -> S^2 = sig^2*X2/(n-1)
sig2_1 = sig_trg^2*X2_1/v = 0.00943574031250296
sig2_2 = sig_trg^2*X2_2/v = 0.00676759104184816
sig_UCL = Sqrt(sig2_1) = 0.097137738868593
sig_UWL = Sqrt(sig2_2) = 0.0822653696390417
$M seqNo[0] {1,25} > OK (2[0~1])
arrSigT = ARR.INIT1D(2,sig_trg) = OK: arrSigT (2[0~1])
arrUCL = ARR.INIT1D(2,sig_UCL) = OK: arrUCL (2[0~1])
arrUWL = ARR.INIT1D(2,sig_UWL) = OK: arrUWL (2[0~1])
! Figure 24.3. Control chart for standard deviation
$TS seqNo,seqNo,seqNo;arrUCL,arrUWL,arrSigT;Control chart for standard deviation;Sequence number;Percent uranium;UCL=0.0972,UWL=0.0822,σ_target=0.06;2,2,2;0,0,0;UR > OK
# 24.7 Control charts for attributes
pie_trg = 0.278 = 0.278
n = 100 = 100
LCL = pie_trg-3*Sqrt(pie_trg*(1-pie_trg)/n) = 0.143595982202912
UCL = pie_trg+3*Sqrt(pie_trg*(1-pie_trg)/n) = 0.412404017797088
