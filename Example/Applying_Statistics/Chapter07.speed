# 7. Continuous distributions
## Example 7.1 Fuel pump gauge
a = -0.005 = -0.005
b = 0.005 = 0.005
μ = (a+b)/2 = 0
σ² = (a-b)^2/12 = 8.33333333333333E-06
σ = Sqrt(σ²) = 0.00288675134594813
## Example 7.3 UO₂ enrichment
μ = 87.5 = 87.5
σ = 0.4 = 0.4
! Pr{Y≤88.0}=Pr{Z≤1.25}
Pr = MATH.CDF.NRM(μ,σ,88.0) = 0.894350226333145
Z = (88.0-μ)/σ = 1.25
Pr = MATH.CDF.NRM(0,1,Z) = 0.894350226333145
! Pr{Y>88.0}=Pr{Z>1.25}
Pr = 1.0 - MATH.CDF.NRM(μ,σ,88.0) = 0.105649773666855
Pr = 1.0 - MATH.CDF.NRM(0,1,Z) = 0.105649773666855
! Pr{87.0<Y≤88.1}=Pr{-1.25<Z≤1.50}
Pr = MATH.CDF.NRM(μ,σ,88.1) - MATH.CDF.NRM(μ,σ,87.0) = 0.827543025064285
Pr = MATH.CDF.NRM(0,1,1.5) - MATH.CDF.NRM(0,1,-1.25) = 0.827543025064287
# 7.7 Spreadsheet functions for normal probabilities
! Table 7.1 Selected values for the standard normal distribution
$M q[0] {0.005,0.01,0.025,0.05,0.01,0.02,0.8,0.9,0.95,0.975,0.99,0.995} > OK (12[0~11])
cnt = ARR.CNT(q) = 12
$PN "Table 7.1 Selected values for the standard normal distribution" > Table 7.1 Selected values for the standard normal distribution
$PN "Quantile" "z-value" > Quantile z-value
i = -1 = -1
$L1 12
i = i + 1 = 11
z = MATH.ICDF.NRM(0,1,q[i]) = 2.5758293035489
$PN {4:F3 7:F3} q[i] z >0.995  2.576
$L1
# 7.9 Lognormal distribution
y = ARR.INIT.LINE1D(100,0.00001,0.004) = OK: y (101[0~100])
f1 = ARR.INIT1D(101,0.0) = OK: f1 (101[0~100])
f2 = ARR.INIT1D(101,0.0) = OK: f2 (101[0~100])
f3 = ARR.INIT1D(101,0.0) = OK: f3 (101[0~100])
i = -1 = -1
$L1 101
i = i + 1 = 100
f1[i] = MATH.PDF.LOGNRM(-7,1.4,y[i]) = 40.7875641796978
f2[i] = MATH.PDF.LOGNRM(-7,0.67,y[i]) = 13.0406650221474
f3[i] = MATH.PDF.LOGNRM(-6.5,0.67,y[i]) = 51.236948787617
$L1
f1 = ARR.CAT.COL(f1,f2) = OK: f1 (202[0~100,0~1])
f1 = ARR.CAT.COL(f1,f3) = OK: f1 (303[0~100,0~2])
! Figure 7.11 Three lognormal densities
$TS y;f1;Three lognormal densities;y;f(y);0;UR > OK
(MATH.CDF.LOGNRM(-7,4,0.001)) = 0.509199264443116
ln_y = Ln(0.001) = -6.90775527898214
(MATH.CDF.NRM(-7,4,ln_y)) = 0.509199264443116
