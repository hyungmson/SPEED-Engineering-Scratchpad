# 16. One-way ANOVA
# 16.2 One-way ANOVA: Data structure
## Example 16.1 Enriched uranium from four production lines
! Table 16.1. Data layout for percent uranium from four production lines
$M D1[0] {87.2,87.4,87.5} > OK (3[0~2])
$M D2[0] {87.7,87.7,88.0,87.8,88.1,87.7,87.6,88.3,88.0,87.8,87.6} > OK (11[0~10])
$M D3[0] {88.5,88.9,88.5,88.6,88.7,88.7,88.9,88.3,88.8,88.4,88.8,88.5,88.2,88.3,88.4} > OK (15[0~14])
$M D4[0] {87.5,87.3,87.2,87.6,87.4,87.9} > OK (6[0~5])
k = 4 = 4
n = ARR.INIT1D(k,0.0) = OK: n (4[0~3])
n[0] = ARR.CNT(D1) = 3
n[1] = ARR.CNT(D2) = 11
n[2] = ARR.CNT(D3) = 15
n[3] = ARR.CNT(D4) = 6
n_plus = ARR.SUM(n) = 35
# 16.3 Descriptive statistics
! Box plot for Figure 16.1 Observations plotted by treatment groups
$TX D1,D2,D3,D4;Line 1,Line 2,Line 3,Line 4;Observations plotted by treatment groups;Treatment;Uranium enrichment (%);Y;UR > OK
! Table 16.2 Descriptive statistics for Example 16.1
/ mean
m = ARR.INIT1D(k,0.0) = OK: m (4[0~3])
m[0] = ARR.AVG(D1) = 87.3666666666667
m[1] = ARR.AVG(D2) = 87.8454545454545
m[2] = ARR.AVG(D3) = 88.5666666666667
m[3] = ARR.AVG(D4) = 87.4833333333333
/ unadjusted sum of squared
y2 = ARR.INIT1D(k,0.0) = OK: y2 (4[0~3])
y2_tmp = ARR.OPEL.U(D1,2,^) = OK: y2_tmp (3[0~2])
y2[0] = ARR.SUM(y2_tmp) = 22898.85
y2_tmp = ARR.OPEL.U(D2,2,^) = OK: y2_tmp (11[0~10])
y2[1] = ARR.SUM(y2_tmp) = 84885.57
y2_tmp = ARR.OPEL.U(D3,2,^) = OK: y2_tmp (15[0~14])
y2[2] = ARR.SUM(y2_tmp) = 117661.53
y2_tmp = ARR.OPEL.U(D4,2,^) = OK: y2_tmp (6[0~5])
y2[3] = ARR.SUM(y2_tmp) = 45920.31
/ adjusted sum of squares
m2 = ARR.OPEL.B(m,m,*) = OK: m2 (4[0~3])
n_m2 = ARR.OPEL.B(n,m2,*) = OK: n_m2 (4[0~3])
SS = ARR.OPEL.B(y2,n_m2,-) = OK: SS (4[0~3])
$PN "SS" > SS
$PM SS > OK
/ degrees of freedom
v = ARR.OPEL.U(n,1,-) = OK: v (4[0~3])
$PN "v" > v
$PM v > OK
/ variance
S2 = ARR.OPEL.B(SS,v,/) = OK: S2 (4[0~3])
$PN "S2" > S2
$PM S2 > OK
# 16.4 Model and assumptions
alpha = 0.05 = 0.05
# 16.5 Partition of the total sum of squares
Sum = ARR.INIT1D(k,0.0) = OK: Sum (4[0~3])
Sum[0] = ARR.SUM(D1) = 262.1
Sum[1] = ARR.SUM(D2) = 966.3
Sum[2] = ARR.SUM(D3) = 1328.5
Sum[3] = ARR.SUM(D4) = 524.9
Ybb = ARR.SUM(Sum)/n_plus = 88.0514285714286
CT = n_plus*Ybb^2 = 271356.892571429
Sum2 = ARR.INIT1D(k,0.0) = OK: Sum2 (4[0~3])
D2_1 = ARR.OPEL.U(D1,2,^) = OK: D2_1 (3[0~2])
D2_2 = ARR.OPEL.U(D2,2,^) = OK: D2_2 (11[0~10])
D2_3 = ARR.OPEL.U(D3,2,^) = OK: D2_3 (15[0~14])
D2_4 = ARR.OPEL.U(D4,2,^) = OK: D2_4 (6[0~5])
Sum2[0] = ARR.SUM(D2_1) = 22898.85
Sum2[1] = ARR.SUM(D2_2) = 84885.57
Sum2[2] = ARR.SUM(D2_3) = 117661.53
Sum2[3] = ARR.SUM(D2_4) = 45920.31
SumY2 = ARR.SUM(Sum2) = 271366.26
/ SS_Total
SSTot = SumY2 - CT = 9.36742857098579
vTot = n_plus - 1 = 34
SqSum = ARR.OPEL.U(Sum,2,^) = OK: SqSum (4[0~3])
CTi = ARR.OPEL.B(SqSum,n,/) = OK: CTi (4[0~3])
$PN "CTi" > CTi
$PM CTi > OK
/ SS_Between
vBet = k - 1 = 3
SSBet = ARR.SUM(CTi) - CT = 7.79182250995655
AdjSSi = ARR.OPEL.B(Sum2,CTi,-) = OK: AdjSSi (4[0~3])
$PN "AdjSSi" > AdjSSi
$PM AdjSSi > OK
/ SS_Within
SSWith = ARR.SUM(AdjSSi) = 1.57560606061088
/ SS_Within (shorter method)
SSWith_Short = SSTot - SSBet = 1.57560606102924
vWith = n_plus - k = 31
# 16.6 The one-way ANOVA table
! Table 16.3. General one-way ANOVA table
MSBet = SSBet/vBet = 2.59727416998552
MSWith = SSWith/vWith = 0.0508260019551897
/ F ratio (variance ratio)
F = MSBet/MSWith = 51.1012881216859
p = 1 - alpha = 0.95
F_crit = MATH.ICDF.FIS(vBet,vWith,p) = 2.91133401371484
rejectH0 = F > F_crit = 1
/ reject H0 (equal means)
# 16.8 Duncan’s multiple range test
## Example 16.2. Duncan’s multiple range test
! Step 1. harmonic mean
one_n = ARR.OPEL.U(n,-1,^) = OK: one_n (4[0~3])
n_h = k/ARR.SUM(one_n) = 6.08294930875577
! Step 2. pseudo standard deviation
S_pseudo = Sqrt(MSWith/n_h) = 0.091408351287274
! Step 3. q_0.95(p,n₊-k) p.334
df = n_plus - k = 31
nTreats = 2 = 2
nGroups = 1 = 1
p = 0.95 = 0.95
* numbers are consistent with R's qtukey(0.95,31,2..4,1)
q_crit_2 = MATH.ICDF.STU.RNG(nGroups,nTreats,df,p) = 2.88430757657062
nTreats = 3 = 3
q_crit_3 = MATH.ICDF.STU.RNG(nGroups,nTreats,df,p) = 3.48064667086512
nTreats = 4 = 4
q_crit_4 = MATH.ICDF.STU.RNG(nGroups,nTreats,df,p) = 3.83827743024067
! Step 4. Calculate R*_p for p = 2,..,k
Rs_2 = q_crit_2*S_pseudo = 0.263649800179713
Rs_3 = q_crit_3*S_pseudo = 0.31816017359732
Rs_4 = q_crit_4*S_pseudo = 0.350850611681454
! Step 7.Ranges of pairs of means are tested
/ 1st stage: tests largest mean
(m[2]-m[0]) > Rs_4 = 1
(m[2]-m[3]) > Rs_3 = 1
(m[2]-m[1]) > Rs_2 = 1
* y_bar_3 is significantly larger than any of smaller sample means
/ 2nd stage: tests second largest mean
(m[1]-m[0]) > Rs_3 = 1
(m[1]-m[3]) > Rs_2 = 1
* y_bar_2 is significantly larger than y_bar_1 or y_bar_4
/ last stage: tests second smallest
(m[3]-m[0]) < Rs_2 = 1
* conclude y_bar_4 and y_bar_1 not significantly different
# 16.9 T-test and ANOVA equivalence
alpha = 0.1 = 0.1
v = 9 = 9
p1 = 1.0-alpha = 0.9
p2 = 1.0-alpha/2 = 0.95
(MATH.ICDF.STU(0,1,v,p2))^2 = 3.360303023872
(MATH.ICDF.FIS(1,v,p1)) = 3.36030302387167
