CDF11_3 = MATH.CDF.BIN(pie,11,3) = 0.981465238799999
/ assurance may not be achived unless we buy at least 11 chips
# 22.6 Normal approximation to the binomial
## Example 22.5 Water impurity
n = 63 = 63
y = 16 = 16
p = y/n = 0.253968253968254
pie = 0.1 = 0.1
var = pie*(1-pie)/n = 0.00142857142857143
sd = Sqrt(var) = 0.0377964473009227
z = (p - pie)/sd = 4.07361709798834
z_crit = MATH.ICDF.NRM(0,1,0.95) = 1.64485362695147
rejectH0 = z > z_crit = 1
/ reject H0, claim contamination > 10%
## Example 22.6 Mask filters
pie = 0.05 = 0.05
alpha = 0.05 = 0.05
y = 1 = 1
n = 100 = 100
p = y/n = 0.01
var = pie*(1-pie)/n = 0.000475
sd = Sqrt(var) = 0.0217944947177034
z = (p - pie)/sd = -1.83532587096449
z_crit = MATH.ICDF.NRM(0,1,alpha) = -1.64485362695147
rejectH0 = z < z_crit = 1
/ reject H0
# 22.7 Confidence interval for a proportion: Normal approximation applies
## Example 22.7 Computer updates
y = 7 = 7
n = 100 = 100
p = y/n = 0.07
z_crit = MATH.ICDF.NRM(0,1,0.95) = 1.64485362695147
UCL = p + z_crit*Sqrt{p*(1-p)/n} = 0.111967949540287
# 22.8 Confidence interval for a proportion: Normal approximation does not apply
## Example 22.8. Two-sided confidence interval for proportion
p = 0.16 = 0.16
alpha = 0.05 = 0.05
n = 25 = 25
y = 4 = 4
dof1 = 2*(y+1) = 10
dof2 = 2*(n-y) = 42
p = 1-0.5*alpha = 0.975
f1 = MATH.ICDF.FIS(dof1,dof2,p) = 2.37100590491224
dof1 = 2*(n-y+1) = 44
dof2 = 2*y = 8
f2 = MATH.ICDF.FIS(dof1,dof2,p) = 3.82480094458083
pie_U = (y+1)*f1/(n-y+(y+1)*f1) = 0.360828454459273
pie_L = y/(y+(n-y+1)*f2) = 0.0453794523717538
## Example 22.9. One-sided confidence interval for proportion
p = 1 - alpha = 0.95
dof1 = 2*(y+1) = 10
dof2 = 2*(n-y) = 42
f1 = MATH.ICDF.FIS(dof1,dof2,p) = 2.0649940145156
pie_U = (y+1)*f1/(n-y+(y+1)*f1) = 0.329608298065591
# 22.9 Confidence interval for a sample with no defects
## Example 22.10. Contaminated wells
n = 25 = 25
pie_U = 1 - Exp{Ln(alpha)/n} = 0.112928145006843
alpha = 0.1 = 0.1
pie_U = 1 - Exp{Ln(alpha)/n} = 0.0879891606440902
alpha = 0.2 = 0.2
pie_U = 1 - Exp{Ln(alpha)/n} = 0.0623490459979845
alpha = 1 - 53/100 = 0.47
pie_U = 1 - Exp{Ln(alpha)/n} = 0.0297494126473417
# 22.10 Sample size for political polling
p = 0.5 = 0.5
z_crit = MATH.ICDF.NRM(0,1,0.975) = 1.95996398454005
$S0 AERR:1.0e-7 > OK
$S0 NMAX:1000 > OK
* 3% margin of error
$SB z_crit*Sqrt(p*(1-p)/n) - 0.03 = 0;n:0.0~10000.0 > Good n:1067.06619262695 (n:19,f:8.01543904895008E-08)
nRndUp = Ceiling(n) = 1068
* 5% margin of error
$SB z_crit*Sqrt(p*(1-p)/n) - 0.05 = 0;n:0.0~10000.0 > Good n:384.14478302002 (n:21,f:7.1525675569839E-08)
nRndUp = Ceiling(n) = 385
* 90% confidence level
z_crit = MATH.ICDF.NRM(0,1,0.95) = 1.64485362695147
$SB z_crit*Sqrt(p*(1-p)/n) - 0.05 = 0;n:0.0~10000.0 > Good n:270.555019378662 (n:22,f:-6.22765697275152E-08)
nRndUp = Ceiling(n) = 271
# 22.11 Binomial approximation to the hypergeometric distribution
! Table 22.5. Hypergeometric and binomial probabilities compared
ns = 10 = 10
N = 100 = 100
M = 25 = 25
pie = M/N = 0.25
* Hypergeometric distribution
PrH0 = MATH.PMF.HYPGEO(N,M,ns,0) = 0.0478865561843905
PrH1 = MATH.PMF.HYPGEO(N,M,ns,1) = 0.181388470395418
PrH2 = MATH.PMF.HYPGEO(N,M,ns,2) = 0.292387385115003
PrH3 = MATH.PMF.HYPGEO(N,M,ns,3) = 0.263721955201767
PrH4 = MATH.PMF.HYPGEO(N,M,ns,4) = 0.147149206887943
PrH5 = MATH.PMF.HYPGEO(N,M,ns,5) = 0.0529737144796594
* Binomial distribution
PrB0 = MATH.PMF.BIN(pie,ns,0) = 0.0563135147094727
PrB1 = MATH.PMF.BIN(pie,ns,1) = 0.187711715698242
PrB2 = MATH.PMF.BIN(pie,ns,2) = 0.281567573547363
PrB3 = MATH.PMF.BIN(pie,ns,3) = 0.250282287597657
PrB4 = MATH.PMF.BIN(pie,ns,4) = 0.145998001098633
PrB5 = MATH.PMF.BIN(pie,ns,5) = 0.0583992004394531
* Difference
Dff0 = PrH0 - PrB0 = -0.0084269585250822
Dff1 = PrH1 - PrB1 = -0.00632324530282399
Dff2 = PrH2 - PrB2 = 0.01081981156764
Dff3 = PrH3 - PrB3 = 0.01343966760411
Dff4 = PrH4 - PrB4 = 0.00115120578930999
Dff5 = PrH5 - PrB5 = -0.0054254859597937
