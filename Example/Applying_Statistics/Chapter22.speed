# 22. Binomial experiments
# 22.4 Examples of binomial experiments
## Example 22.1. Head count
y = 6 = 6
n = 6 = 6
pie = 0.5 = 0.5
Pr6 = MATH.PMF.BIN(pie,n,y) = 0.015625
## Example 22.2 Acceptance sampling
n = 124 = 124
pie = 0.05 = 0.05
* probabilty that any switch in sample is defective
Pr0 = MATH.PMF.BIN(pie,n,0) = 0.00172872955061452
! Table 22.1 Binomial probabilities for n=124 and pie=0.05
Pr1 = MATH.PMF.BIN(pie,n,1) = 0.0112822349619055
CDF1 = MATH.CDF.BIN(pie,n,1) = 0.0130109645125203
Pr2 = MATH.PMF.BIN(pie,n,2) = 0.0365188131661664
CDF2 = MATH.CDF.BIN(pie,n,2) = 0.0495297776786884
CompPr2 = 1-CDF2 = 0.950470222321312
## Example 22.3 Drug testing
pie = 1/12 = 0.0833333333333333
n = 12 = 12
Pr0 = MATH.PMF.BIN(pie,n,0) = 0.351995628014137
! Table 22.2 Binomial probabilities for n=12 and pie=0.0833
Pr1 = MATH.PMF.BIN(pie,n,1) = 0.383995230560876
CDF1 = MATH.CDF.BIN(pie,n,1) = 0.735990858575009
Pr2 = MATH.PMF.BIN(pie,n,2) = 0.191997615280438
CDF2 = MATH.CDF.BIN(pie,n,2) = 0.927988473855451
* probability of being selected more than twice
Pr_GT2 = 1-CDF2 = 0.072011526144549
## Example 22.4 Sampling memory chips
pie = 0.1 = 0.1
n = 8 = 8
Pr0 = MATH.PMF.BIN(pie,n,0) = 0.43046721
! Table 22.3 Binomial probabilities for pie=0.1 and varying n
Pr9_0 = MATH.PMF.BIN(pie,9,0) = 0.387420489
Pr9_1 = MATH.PMF.BIN(pie,9,1) = 0.387420489
CDF9_1 = MATH.CDF.BIN(pie,9,1) = 0.774840977999992
Pr10_0 = MATH.PMF.BIN(pie,10,0) = 0.3486784401
Pr10_1 = MATH.PMF.BIN(pie,10,1) = 0.387420489000001
Pr10_2 = MATH.PMF.BIN(pie,10,2) = 0.1937102445
CDF10_2 = MATH.CDF.BIN(pie,10,2) = 0.929809173599998
Pr11_0 = MATH.PMF.BIN(pie,11,0) = 0.31381059609
Pr11_1 = MATH.PMF.BIN(pie,11,1) = 0.38354628411
Pr11_2 = MATH.PMF.BIN(pie,11,2) = 0.213081268950001
