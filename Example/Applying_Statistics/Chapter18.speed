# 18. Regression
# 18.2 Concepts and terms from algebra and geometry
! Table 18.1. Ordered pairs (x, y) for the function y = 3x + 2
$M arrX[0] {-2,0,1,2,5} > OK (5[0~4])
$M arrY[0] {-4,2,5,8,17} > OK (5[0~4])
! Figure 18.1 Graph of the function y = 3x + 2
$TS arrX;arrY;Graph of the function y=3x+2;x;y;5;UL > OK
# 18.3 The concept of regression
## Example 18.1. Five points in search of a trend
! Table 18.2. Five ordered pairs (x, y)
$M arrX[0] {1,2,3,5,7} > OK (5[0~4])
$M arrY[0] {4,3,4,8,9} > OK (5[0~4])
! Figure 18.2. Graph of the data in Table 18.2
$TS arrX;arrY;Graph of the data in Table 18.2;x;y;data;0;10;UL > OK
# 18.6 Fitting a line to data
y_bar = ARR.AVG(arrY) = 5.6
arrLn1 = ARR.INIT1D(5,y_bar) = OK: arrLn1 (5[0~4])
! Figure 18.4. Five points from Table 18.2 and the line y=y_bar
$TS arrX,arrX;arrY,arrLn1;Five points from Table 18.2 and the line y=y_bar;x;y;data,Line 1: y=y_bar=5.6;0,1;10,0;UL > OK
arrLn2 = ARR.OPEL.U(arrX,2,*) = OK: arrLn2 (5[0~4])
arrLn2 = ARR.OPEL.U(arrLn2,-2,+) = OK: arrLn2 (5[0~4])
arrLn3 = ARR.OPEL.U(arrX,8/9,*) = OK: arrLn3 (5[0~4])
arrLn3 = ARR.OPEL.U(arrLn3,2,+) = OK: arrLn3 (5[0~4])
$TS arrX,arrX,arrX,arrX;arrY,arrLn1,arrLn2,arrLn3;Three candidate lines for fitting the data in Table 18.2;x;y;data,Line 1: y=y_bar=5.6,Line 2: y=-2+2x,Line 3: y=2+(8/9)x;0,1,1,1;10,0,0,0;UL > OK
# 18.7 The method of least squares and the regression line
! Table 18.3 Sums of squared deviations for the three lines in Figure 18.5
y_Y1 = ARR.OPEL.B(arrY,arrLn1,-) = OK: y_Y1 (5[0~4])
y_Y2 = ARR.OPEL.B(arrY,arrLn2,-) = OK: y_Y2 (5[0~4])
y_Y3 = ARR.OPEL.B(arrY,arrLn3,-) = OK: y_Y3 (5[0~4])
SS1 = MATH.SUM.SQA(y_Y1) = 29.2
SS2 = MATH.SUM.SQA(y_Y2) = 26
SS3 = MATH.SUM.SQA(y_Y3) = 5.30864197530864
! construct least squares line for Example 18.1
xb = ARR.AVG(arrX) = 3.6
x_xb = ARR.OPEL.U(arrX,xb,-) = OK: x_xb (5[0~4])
Sxx = MATH.SUM.SQA(x_xb) = 23.2
yb = ARR.AVG(arrY) = 5.6
y_yb = ARR.OPEL.U(arrY,yb,-) = OK: y_yb (5[0~4])
Syy = MATH.SUM.SQA(y_yb) = 29.2
xxb_yyb = ARR.OPEL.B(x_xb,y_yb,*) = OK: xxb_yyb (5[0~4])
Sxy = ARR.SUM(xxb_yyb) = 24.2
! regression coefficients
B = Sxy/Sxx = 1.04310344827586
A = yb - B*xb = 1.8448275862069
(MATH.FIT.LIN.ICT(arrX,arrY)) = 1.8448275862069
(MATH.FIT.LIN.SLP(arrX,arrY)) = 1.04310344827586
(MATH.FIT.LIN.R2(arrX,arrY)) = 0.864489844119037
! Table 18.3 The least squares line and sum of squares for Example 18.1
arrLS = ARR.OPEL.U(arrX,B,*) = OK: arrLS (5[0~4])
arrLS = ARR.OPEL.U(arrLS,A,+) = OK: arrLS (5[0~4])
y_YLS = ARR.OPEL.B(arrY,arrLS,-) = OK: y_YLS (5[0~4])
SSLS = MATH.SUM.SQA(y_YLS) = 3.95689655172414
# 18.8 Geometric interpretation of regression components
dev_total = arrY[3] - yb = 2.4
dev_regression = arrLS[3] - yb = 1.4603448275862
residual = arrY[3] - arrLS[3] = 0.9396551724138
# 18.10 Regression ANOVA for a single independent variable
! Table 18.6 Regression ANOVA table for Example 18.1
SS_Total = Syy = 29.2
SS_Reg = Sxy^2/Sxx = 25.2431034482759
SS_Error = SS_Total - SS_Reg = 3.9568965517241
n = ARR.CNT(arrX) = 5
v_Reg = 1 = 1
v_Total = n - 1 = 4
v_Error = n - 2 = 3
MS_Reg = SS_Reg/v_Reg = 25.2431034482759
MS_Error = SS_Error/v_Error = 1.31896551724137
F = MS_Reg/MS_Error = 19.1385620915034
F_crit = MATH.ICDF.FIS(1,3,0.95) = 10.1279644860148
rejectH0 = F > F_crit = 1
/ reject H0 and conclude that β =/= 0
