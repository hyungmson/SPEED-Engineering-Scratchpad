# 18.16 Multiple linear regression
! Table 18.14. ANOVA for MLR with two independent variables
n = ARR.CNT(Temp) = 11
v_Reg = 2 = 2
v_Total = n - 1 = 10
v_Error = n - v_Reg - 1 = 8
arr1 = ARR.INIT1D(n,1.0) = OK: arr1 (11[0~10])
arrX = ARR.CAT.COL(arr1,Time) = OK: arrX (22[0~10,0~1])
