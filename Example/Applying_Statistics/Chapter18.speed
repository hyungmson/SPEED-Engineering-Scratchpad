slp_Temp = arrP[2] = 0.117867780126439
time_x_slp = ARR.OPEL.U(Time,slp_Time,*) = OK: time_x_slp (11[0~10])
temp_x_slp = ARR.OPEL.U(Temp,slp_Temp,*) = OK: temp_x_slp (11[0~10])
Pres_pred = ARR.OPEL.B(time_x_slp,temp_x_slp,+) = OK: Pres_pred (11[0~10])
Pres_pred = ARR.OPEL.U(Pres_pred,ict,+) = OK: Pres_pred (11[0~10])
y_yp = ARR.OPEL.B(Pres,Pres_pred,-) = OK: y_yp (11[0~10])
SS_Error = MATH.SUM.SQA(y_yp) = 3.74142312027829
yb = ARR.AVG(Pres) = 34.2727272727273
y_yb = ARR.OPEL.U(Pres,yb,-) = OK: y_yb (11[0~10])
SS_Total = MATH.SUM.SQA(y_yb) = 15.1818181818182
