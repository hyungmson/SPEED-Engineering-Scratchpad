Sxx = 686.64 = 686.64
xb = 82.4 = 82.4
Y_88 = 24.078 + 0.124*88.0 = 34.99
interval_lower = Y_88 - (MATH.ICDF.STU(0,1,9,0.975))*Sqrt(s2)*Sqrt(1.0 + 1/n + (88.0-xb)^2/Sxx) = 33.2525728469661
interval_upper = Y_88 + (MATH.ICDF.STU(0,1,9,0.975))*Sqrt(s2)*Sqrt(1.0 + 1/n + (88.0-xb)^2/Sxx) = 36.7274271530339
