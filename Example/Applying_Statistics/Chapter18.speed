F_crit = MATH.ICDF.FIS(v_Reg,v_Error,0.95) = 4.45897010752421
rejectH0 = F > F_crit = 1
/ reject H0 and conclude that β =/= 0
xb_1 = ARR.AVG(Time) = 72.9090909090909
xb_2 = ARR.AVG(Temp) = 82.4
x1_xb1 = ARR.OPEL.U(Time,xb_1,-) = OK: x1_xb1 (11[0~10])
S11 = MATH.SUM.SQA(x1_xb1) = 36762.9090909091
x2_xb2 = ARR.OPEL.U(Temp,xb_2,-) = OK: x2_xb2 (11[0~10])
S22 = MATH.SUM.SQA(x2_xb2) = 686.64
x1xb1_by_x2xb2 = ARR.OPEL.B(x1_xb1,x2_xb2,*) = OK: x1xb1_by_x2xb2 (11[0~10])
